[debug] [2026-09-24T01:59:58.415Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/military-tracker-96bdd/rulesets {"name":"projects/military-tracker-96bdd/rulesets/cc3ba48b-4b1b-4d38-81be-9076f8d63f68","source":{"files":[{"content":"rules_version = '2';\n\n// MilitaryTracker — Firestore 보안 규칙\n// 원칙: 본인 데이터만 읽고 쓴다. role == 'admin' 계정은 전체 허용.\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // ── 공통 함수 ─────────────────────────────────────────────────────────\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function uid() {\n      return request.auth.uid;\n    }\n\n    function userDoc() {\n      return get(/databases/$(database)/documents/users/$(uid())).data;\n    }\n\n    // 관리자 판정\n    //  1) 커스텀 클레임 admin == true  → 문서 read 비용 없음 (권장)\n    //  2) users/{uid}.role == 'admin'  → 콘솔에서 필드만 바꿔도 적용\n    function isAdmin() {\n      return signedIn() && (\n        request.auth.token.admin == true ||\n        (exists(/databases/$(database)/documents/users/$(uid())) && userDoc().role == 'admin')\n      );\n    }\n\n    function isOwner(ownerId) {\n      return signedIn() && uid() == ownerId;\n    }\n\n    function ownsExisting() {\n      return signedIn() && resource.data.userId == uid();\n    }\n\n    function ownsIncoming() {\n      return signedIn() && request.resource.data.userId == uid();\n    }\n\n    // role 필드는 본인이 바꿀 수 없다 (권한 상승 차단)\n    function roleUnchanged() {\n      return !('role' in request.resource.data) ||\n             request.resource.data.role == resource.data.role;\n    }\n\n    // sub(구독) 필드도 본인이 바꿀 수 없다.\n    // Cloud Functions 는 Admin SDK 라 이 규칙을 통과하지 않는다 —\n    // 즉 앱을 뜯어 고쳐도 스스로 PRO 가 될 수 없다.\n    function subUnchanged() {\n      return !('sub' in request.resource.data) ||\n             (('sub' in resource.data) && request.resource.data.sub == resource.data.sub);\n    }\n\n    // 코치 사용량도 서버만 쓴다. 클라이언트가 고칠 수 있으면 한도가 무의미하다.\n    function coachUsageUnchanged() {\n      return !('coachUsage' in request.resource.data) ||\n             (('coachUsage' in resource.data) &&\n              request.resource.data.coachUsage == resource.data.coachUsage);\n    }\n\n    // ── users ─────────────────────────────────────────────────────────────\n    match /users/{userId} {\n      allow get: if isOwner(userId) || isAdmin();\n      allow list: if isAdmin();\n\n      // 가입 시 본인 문서 생성 — 스스로 admin 이나 구독을 부여할 수 없다\n      allow create: if (isOwner(userId)\n                        && request.resource.data.role == 'user'\n                        && !('sub' in request.resource.data)\n                        && !('coachUsage' in request.resource.data)) || isAdmin();\n      allow update: if (isOwner(userId) && roleUnchanged() && subUnchanged()\n                        && coachUsageUnchanged()) || isAdmin();\n      allow delete: if isOwner(userId) || isAdmin();\n    }\n\n    // ── plans/{uid} ───────────────────────────────────────────────────────\n    match /plans/{userId} {\n      allow read, write: if isOwner(userId) || isAdmin();\n    }\n\n    // ── workoutLogs ───────────────────────────────────────────────────────\n    match /workoutLogs/{logId} {\n      // list 는 where('userId','==',uid) 로 필터된 쿼리만 통과한다\n      allow read: if isAdmin() || ownsExisting();\n      allow create: if isAdmin() || ownsIncoming();\n      allow update: if (ownsExisting() && ownsIncoming()) || isAdmin();\n      allow delete: if isAdmin() || ownsExisting();\n    }\n\n    // ── weights ───────────────────────────────────────────────────────────\n    match /weights/{weightId} {\n      allow read: if isAdmin() || ownsExisting();\n      allow create: if isAdmin() || ownsIncoming();\n      allow update: if (ownsExisting() && ownsIncoming()) || isAdmin();\n      allow delete: if isAdmin() || ownsExisting();\n    }\n\n    // ── 구독 관련 컬렉션 ──────────────────────────────────────────────────\n    // promoCodes / promoRedemptions / subEvents 는 전부 Cloud Functions(Admin SDK)\n    // 전용이다. 앱에서는 읽지도 쓰지도 않는다 — 코드 목록이 노출되면 안 된다.\n    match /promoCodes/{code} { allow read, write: if isAdmin(); }\n    match /promoRedemptions/{id} { allow read, write: if isAdmin(); }\n    match /subEvents/{id} { allow read, write: if isAdmin(); }\n\n    // ── 그 외 모든 경로 ───────────────────────────────────────────────────\n    // 정의되지 않은 컬렉션은 관리자만 접근 가능\n    match /{document=**} {\n      allow read, write: if isAdmin();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-09-24T01:59:58.377295Z","metadata":{"services":["cloud.firestore"]}}
