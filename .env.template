# 환경 변수 템플릿
# 이 파일을 복사하여 .env 파일을 생성하고 실제 값을 입력하세요.
# .env 파일은 절대 Git에 커밋하지 마세요!

# Firebase 설정 (firebase_options.dart에서 자동 생성됨)
# 아래는 참고용입니다.

# Android
# FIREBASE_ANDROID_API_KEY=your_android_api_key_here
# FIREBASE_ANDROID_APP_ID=your_android_app_id_here
# FIREBASE_ANDROID_MESSAGING_SENDER_ID=your_messaging_sender_id
# FIREBASE_ANDROID_PROJECT_ID=your_project_id

# iOS
# FIREBASE_IOS_API_KEY=your_ios_api_key_here
# FIREBASE_IOS_APP_ID=your_ios_app_id_here
# FIREBASE_IOS_MESSAGING_SENDER_ID=your_messaging_sender_id
# FIREBASE_IOS_PROJECT_ID=your_project_id
# FIREBASE_IOS_BUNDLE_ID=your_bundle_id

# Web
# FIREBASE_WEB_API_KEY=your_web_api_key_here
# FIREBASE_WEB_APP_ID=your_web_app_id_here
# FIREBASE_WEB_MESSAGING_SENDER_ID=your_messaging_sender_id
# FIREBASE_WEB_PROJECT_ID=your_project_id

# Google Sign-In (선택사항)
# GOOGLE_SIGN_IN_CLIENT_ID_IOS=your_ios_client_id
# GOOGLE_SIGN_IN_CLIENT_ID_WEB=your_web_client_id

# 기타 API 키
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# 앱 설정
# APP_NAME=MilitaryTracker
# APP_VERSION=1.0.2
# ENABLE_DEBUG_LOGGING=true

# Cloud Functions URL (프로덕션)
# CLOUD_FUNCTIONS_URL=https://your-region-your-project.cloudfunctions.net

# Sentry DSN (에러 트래킹 - 선택사항)
# SENTRY_DSN=your_sentry_dsn_here
